# Copia este archivo como .env.local y rellena los valores reales.
# .env.local está ignorado por git (.env*); este template NO lo está (!.env.template),
# así que aquí solo van marcadores — nunca pegues una clave real en este archivo.

# Resend (envío del formulario de contacto). Server-side.
RESEND_API_KEY=re_xxxxxxxx

# Contraseña de Postgres del proyecto Supabase.
# Ningún código la lee: es solo para conexión directa a la base desde tu máquina.
# NO la despliegues como variable de entorno en el hosting.
SUPABASE_DB_PASSWORD=XXXXXXXXXXX

# Proyecto Supabase. En local apunta al de desarrollo; en el hosting, al de producción.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# Origen público de la app. En local, http://localhost:3000; en producción, https://tu-dominio.
NEXT_PUBLIC_APP_URL=http://localhost:3000
